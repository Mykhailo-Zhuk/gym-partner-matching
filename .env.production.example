# Production environment — copy to .env.production and fill in EVERY value.
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Production rules:
#  - ALL secrets below are mandatory and must be unique random values.
#  - Never commit .env.production (already covered by .gitignore/.dockerignore).
#  - Put TLS in front of API + MinIO + admin (reverse proxy or cloud LB);
#    JWTs travel in headers, photos travel via presigned URLs — HTTPS is not optional.
#  - Consider managed Postgres/S3 for real production scale; this compose file
#    is the self-hosted MVP baseline.

# --- Postgres ---
POSTGRES_USER=gymbros
POSTGRES_PASSWORD=<RUN: openssl rand -base64 24>
POSTGRES_DB=gymbros

# --- MinIO (object storage, photo uploads) ---
# Must be the PUBLIC https endpoint (behind your reverse proxy), reachable from
# both the api container and mobile clients. Example: https://s3.example.com
S3_ENDPOINT=https://<PROD_S3_HOST>
S3_ACCESS_KEY=<RUN: openssl rand -hex 16>
S3_SECRET_KEY=<RUN: openssl rand -base64 24>
S3_BUCKET=gymbros-uploads
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- JWT ---
JWT_ACCESS_SECRET=<RUN: openssl rand -base64 32>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Rate limit (pre-auth matching preview, requests/min/IP) ---
PREVIEW_RATE_LIMIT=30

# --- Host ports ---
API_PORT=3000
ADMIN_PORT=8080

# --- Firebase / FCM (required in production for real push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON-escaped private key from the service account file: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=