# API
PORT=3000
NODE_ENV=development

# Database / cache
DATABASE_URL=postgresql://gymbros:gymbros@localhost:5433/gymbros
REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Firebase (push notifications + social auth). Leave empty to use the log/no-op provider.
FCM_SERVICE_ACCOUNT_JSON=

# Object storage (MinIO locally, S3 in prod)
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-west-1
S3_BUCKET=gymbros-uploads
S3_ACCESS_KEY=gymbros
S3_SECRET_KEY=gymbros123
