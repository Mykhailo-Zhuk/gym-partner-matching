// GymBrosUK — base data model (Part 0) + Part 1 needs (reports, matches for admin card)
// + Part 4 (workouts, pair goals, ratings)
// + Part 5 (referrals, badges, group matches).
// Column names follow the snake_case model from implementation/part-0-foundation.md.

generator client {
  provider = "prisma-client-js"
  seed     = "tsx prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Goal {
  MASS // Набір маси
  CUT // Схуднення
  STRENGTH // Сила
  ENDURANCE // Витривалість
  GENERAL // Загальна підтримка
}

enum Level {
  BEGINNER // Початківець
  INTERMEDIATE // Середній
  ADVANCED // Просунутий
}

enum MatchStatus {
  PENDING
  ACTIVE
  DECLINED
  ENDED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM // e.g. "Дмитро в дорозі 🚗" (story #4 hook)
}

enum GoalMetric {
  WORKOUT_COUNT
  TOTAL_KG
}

enum PairGoalStatus {
  PENDING_CONFIRM // active only after the partner confirms (story #2)
  ACTIVE
  DONE
}

enum SocialProvider {
  GOOGLE
  APPLE
}

enum ReferralStatus {
  PENDING // referee signed up but bonus not yet granted (e.g. social login edge case)
  GRANTED
}

enum GroupMemberStatus {
  INVITED
  CONFIRMED
  DECLINED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash") // null => social-only account
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  level        Level?
  goal         Goal?
  schedule     String? // free text for now, e.g. "вечір після 18:00"
  gymId        String?    @map("gym_id") @db.Uuid
  photoUrl     String?    @map("photo_url")
  bio          String?
  blockedReason String?   @map("blocked_reason")
  // Part 5 (#9): referral-driven bonus days extend the premium window.
  // `subscriptionUntil > now()` ⇒ premium is active; null = never paid/granted.
  subscriptionUntil DateTime? @map("subscription_until")
  // Part 5 (#9): the referral code USED to sign up (set once, never changed).
  referredByCodeId   String?   @map("referred_by_code_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")

  gym            Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  socialAccounts SocialAccount[]
  refreshTokens  RefreshToken[]
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  reportsFiled   Report[]        @relation("reports_filed")
  reportsReceived Report[]       @relation("reports_received")
  matchesAsA     Match[]         @relation("match_user_a")
  matchesAsB     Match[]         @relation("match_user_b")
  matchRequestsFrom MatchRequest[] @relation("match_request_from")
  matchRequestsTo   MatchRequest[] @relation("match_request_to")
  messages       Message[]
  workouts       Workout[]
  ratingsGiven    Rating[] @relation("ratings_given")
  ratingsReceived Rating[] @relation("ratings_received")
  referralCode    ReferralCode?
  referralsGiven  Referral[] @relation("referrals_referrer")
  referralsReceived Referral[] @relation("referral_referee")
  referredBy      ReferralCode? @relation("referral_code_referred_by", fields: [referredByCodeId], references: [id], onDelete: SetNull)
  userBadges      UserBadge[]
  groupMemberships GroupMember[]
  groupsCreated   GroupMatch[]   @relation("group_creator")

  @@index([status])
  @@map("users")
}

model SocialAccount {
  id             String          @id @default(uuid()) @db.Uuid
  provider       SocialProvider
  providerUserId String          @map("provider_user_id")
  userId         String          @map("user_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("social_accounts")
}

model Gym {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  city    String
  lat     Float
  lng     Float

  users   User[]

  @@map("gyms")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  platform  String // ios | android
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String // e.g. USER_BLOCKED, USER_UNBLOCKED, MATCH_PARTNER_BLOCKED
  payload   Json // {title, body, data?}
  sentAt    DateTime? @map("sent_at") // null => provider failed / no devices
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String // BLOCK_USER, UNBLOCK_USER, ADMIN_LOGIN ...
  targetType String   @map("target_type") // user | report | ...
  targetId   String   @map("target_id")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("audit_log")
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetId   String       @map("target_id") @db.Uuid
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("reports_filed", fields: [reporterId], references: [id], onDelete: Cascade)
  target   User @relation("reports_received", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@map("reports")
}

// Part 2 (#1): pending request → Match on accept.
enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model MatchRequest {
  id         String        @id @default(uuid()) @db.Uuid
  fromUserId String        @map("from_user_id") @db.Uuid
  toUserId   String        @map("to_user_id") @db.Uuid
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now()) @map("created_at")

  fromUser User @relation("match_request_from", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("match_request_to", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("match_requests")
}

// Part 1: admin match history + notify active matches on block.
// Part 3: scheduled_at drives workout reminders (story #4); messages = chat (story #7).
model Match {
  id          String      @id @default(uuid()) @db.Uuid
  userAId     String      @map("user_a_id") @db.Uuid
  userBId     String      @map("user_b_id") @db.Uuid
  status      MatchStatus @default(ACTIVE)
  scheduledAt DateTime?   @map("scheduled_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  userA    User       @relation("match_user_a", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User       @relation("match_user_b", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  workouts Workout[]
  goals    PairGoal[]
  ratings  Rating[]

  @@index([status])
  @@map("matches")
}

// Story #7 — chat history persisted server-side; realtime delivery via WebSocket.
// sender_id is null only for SYSTEM messages.
model Message {
  id        String      @id @default(uuid()) @db.Uuid
  matchId   String      @map("match_id") @db.Uuid
  senderId  String?     @map("sender_id") @db.Uuid
  type      MessageType @default(TEXT)
  body      String?
  mediaUrl  String?     @map("media_url")
  createdAt DateTime    @default(now()) @map("created_at")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([matchId, createdAt, id])
  @@map("messages")
}

// Part 4 (story #2): manual workout entry, visible to both partners.
// Tonnage for TOTAL_KG = sets * (reps ?? 1) * weightKg — computed server-side only.
model Workout {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  type      String
  sets      Int?
  reps      Int?
  weightKg  Float?   @map("weight_kg")
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId, date])
  @@map("workouts")
}

// Part 4 (story #2): joint goal — created by one partner, ACTIVE only after the other confirms.
model PairGoal {
  id        String         @id @default(uuid()) @db.Uuid
  matchId   String         @map("match_id") @db.Uuid
  title     String
  target    Int
  metric    GoalMetric
  due       DateTime?      @db.Date
  status    PairGoalStatus @default(PENDING_CONFIRM)
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("pair_goals")
}

// Part 4 (story #5): post-workout rating. One rating per rater per match (DB-enforced).
model Rating {
  id            String   @id @default(uuid()) @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  raterId       String   @map("rater_id") @db.Uuid
  rateeId       String   @map("ratee_id") @db.Uuid
  punctuality   Int // 1..5
  communication Int // 1..5
  spotting      Int // 1..5
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rater User  @relation("ratings_given", fields: [raterId], references: [id], onDelete: Cascade)
  ratee User  @relation("ratings_received", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([matchId, raterId])
  @@index([rateeId, createdAt])
  @@map("ratings")
}

// --- Part 5 (#9) Referrals ---
// One personal code per user, generated on first request (idempotent).
model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Users that signed up using THIS code (kept on ReferralCode for FK direction).
  referredUsers User[]   @relation("referral_code_referred_by")
  redemptions  Referral[]

  @@map("referral_codes")
}

// One row per (referrer, referee) pair. Idempotency: UNIQUE on refereeId — a user
// can only have been referred once even if the same code is submitted again.
model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  codeId         String         @map("code_id") @db.Uuid
  referrerId     String         @map("referrer_id") @db.Uuid
  refereeId      String         @map("referee_id") @db.Uuid
  status         ReferralStatus @default(GRANTED)
  bonusGrantedAt DateTime?      @map("bonus_granted_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  code     ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer User         @relation("referrals_referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User         @relation("referral_referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([referrerId, createdAt])
  @@map("referrals")
}

// --- Part 5 (#10) Badges ---
// Static catalogue; rules evaluated by the engine on each triggering event.
model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // "first_match", "verified_pair", ...
  title       String // "Перший крок"
  description String // "Заверши перше спільне тренування"
  icon        String // emoji or URL fragment, e.g. "🥇"
  rule        String // "first_match_completed" | "n_workouts_with_partner:5" | ...
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

// Idempotency: UNIQUE on (user_id, badge_id). The engine relies on this — the
// "first" insert wins, every retry is a no-op.
model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, awardedAt])
  @@map("user_badges")
}

// --- Part 5 (#11) Group matching ---
model GroupMatch {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  creatorId   String    @map("creator_id") @db.Uuid
  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  creator  User           @relation("group_creator", fields: [creatorId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]

  @@index([creatorId])
  @@map("group_matches")
}

model GroupMember {
  id      String           @id @default(uuid()) @db.Uuid
  groupId String           @map("group_id") @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  status  GroupMemberStatus @default(INVITED)
  invitedAt DateTime        @default(now()) @map("invited_at")
  respondedAt DateTime?     @map("responded_at")

  group GroupMatch @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, status])
  @@map("group_members")
}

// Group chat. Separate from `messages` to keep the pair-chat read path O(1) and
// the original (match_id, created_at) index untouched.
model GroupMessage {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  senderId  String?  @map("sender_id") @db.Uuid
  type      MessageType @default(TEXT)
  body      String?
  mediaUrl  String?  @map("media_url")
  createdAt DateTime @default(now()) @map("created_at")

  group  GroupMatch @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt, id])
  @@map("group_messages")
}
