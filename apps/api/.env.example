# Database (docker-compose exposes Postgres on host port 5433 — 5432 is taken on this machine)
DATABASE_URL=postgresql://gymbros:gymbros@localhost:5433/gymbros

# Redis on host port 6380
REDIS_URL=redis://localhost:6380

# MinIO S3 on host ports 9100 (api) / 9101 (console)
S3_ENDPOINT=http://localhost:9100
S3_REGION=eu-central-1
S3_ACCESS_KEY=gymbros
S3_SECRET_KEY=gymbros-dev
S3_BUCKET=gymbros-uploads

# JWT (refresh tokens are opaque + rotated server-side; see refresh_tokens table)
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Rate limit for the pre-auth matching preview (requests / minute / IP)
PREVIEW_RATE_LIMIT=30

# Firebase / FCM — when empty, pushes are logged to the API console (LogPushProvider)
# and /auth/social accepts dev tokens of the form dev:<uid>:<email>:<name>.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seeder
SEED_ADMIN_EMAIL=admin@gymbros.ua
SEED_ADMIN_PASSWORD=admin1234
