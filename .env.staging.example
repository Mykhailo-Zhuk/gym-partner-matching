# Staging environment — copy to .env.staging and fill in the values.
#   cp .env.staging.example .env.staging
#   docker compose --env-file .env.staging -f docker-compose.prod.yml up -d --build
#
# Single-host staging defaults; safe-ish values, NOT for production.

# --- Postgres ---
POSTGRES_USER=gymbros
POSTGRES_PASSWORD=staging-pg-password-change-me
POSTGRES_DB=gymbros

# --- MinIO (object storage, photo uploads) ---
# S3_ENDPOINT must be reachable from BOTH the api container and mobile clients:
# use the server's public IP or hostname, NOT localhost.
# Example for a host with IP 203.0.113.10:  http://203.0.113.10:9100
S3_ENDPOINT=http://<STAGING_HOST_IP>:9100
S3_ACCESS_KEY=staging-minio-key
S3_SECRET_KEY=staging-minio-secret-change-me
S3_BUCKET=gymbros-uploads
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- JWT ---
# Generate: openssl rand -base64 32
JWT_ACCESS_SECRET=<RUN: openssl rand -base64 32>
JWT_ACCESS_TTL=900

# --- Host ports ---
API_PORT=3000
ADMIN_PORT=8080

# --- Firebase / FCM (optional; empty = pushes logged to console) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=